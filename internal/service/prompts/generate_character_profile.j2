# 相关章节摘要
{{ Summaries }}

# 要求
1. role 只能是：protagonist / antagonist / supporting
2. gender：性别，只能是 male / female / neutral 之一
3. age：年龄或年龄感，简短字符串，如 "16" / "约25岁" / "少年" / "中年"
4. description（中文）：仅描述背景故事——出身来历、成长经历、关键转折、动机与目标，写成连贯段落，150字以内
5. visual_prompt（中文）：图像生成提示词，约60-100字，严格不超过500个字符（部分图像模型会直接拒绝过长的提示词），只覆盖以下 7 项内容，按此顺序，不要涉及其他内容。禁止画风/质量/渲染标签——这些由生成流程另行注入。
   ⚠️ 严禁出现暴力、血腥、伤亡、色情相关敏感词。
{% if GenreVisualHints %}   {{ GenreVisualHints }}
{% endif %}
   [1] 身高：具体估值（如"178cm"）或明确的身高印象（高大/中等/矮小）
   [2] 头身比：体型比例风格（如"8头身英雄比例"用于偏动漫/插画风格，或"真实成人比例"用于写实风格）
   [3] 人种：人类角色必填；非人类种族则描述其种族特征
   [4] 体型：体格/身形，以及标志性的姿态或气质
   [5] 发型：颜色、长度、发质、造型
   [6] 面部特征：脸型、眼睛（形状/颜色/神韵）、眉型、鼻型、唇型、下颌线、显著标记、惯常表情
   [7] 服饰与道具：所穿服装（符合时代背景），以及任何标志性随身物件或武器（如有，须点名）
6. 若信息不足，结合小说类型和角色定位合理推断，不要留空
7. 严格输出单个 JSON 对象，不含任何说明文字

# 输出格式（单个 JSON 对象）
{
  "name": "{{ CharacterName }}",
  "role": "protagonist/antagonist/supporting",
  "gender": "male/female/neutral",
  "age": "如 16 / 约25岁 / 少年 / 中年",
  "description": "出身来历、成长经历、关键转折、动机与目标，150字以内",
  "visual_prompt": "按7项内容撰写的图像生成提示词，约60-100字"
}
