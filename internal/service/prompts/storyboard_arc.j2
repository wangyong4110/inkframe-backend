  "phases": [
    {
      "name": "阶段名称",
      "intensity": 3,
      "content_range_pct": "0-30%",
      "narration_guide": "该阶段旁白风格：例如「内敛克制，用环境意象暗示人物状态，避免直述情绪」",
      "dialogue_guide": "该阶段台词风格：例如「表面平淡，潜台词是积压的怨恨，说一件事，心里装着另一件事」",
      "shot_feel": "该阶段镜头感：例如「静止或慢推，压迫感渐增」"
    }
  ],
  "climax_pct": 70,
  "silence_shots": "建议在第几成内容前后留1-2个无旁白镜头，例如「高潮后（约75%位置）」",
  "key_subtext": "全章核心潜台词，例如「角色表面在争论过去，实则是在争夺对彼此记忆的解释权」"
