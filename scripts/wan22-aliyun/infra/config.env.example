# ── 阿里云账号 ──────────────────────────────────────────────
ALIBABA_ACCESS_KEY=your_access_key_id
ALIBABA_ACCESS_SECRET=your_access_key_secret
REGION_ID=cn-hangzhou

# ── ACR 容器镜像仓库 ────────────────────────────────────────
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your-namespace
ACR_REPO=wan22
IMAGE_TAG=latest

# ── ECS GPU 实例 ────────────────────────────────────────────
# 根据 MODEL_TASK 选择实例规格：
#
#   ti2v-5B（推荐，单卡可跑）
#     → ecs.gn6i-c4g1.xlarge  T4 16G   抢占式约 ¥0.5-0.9/h  ✅
#     → ecs.gn6v-c8g1.2xlarge V100 32G 抢占式约 ¥3-5/h
#
#   t2v-A14B / i2v-A14B（需要 80GB VRAM）
#     → ecs.gn7e-c16g1.4xlarge A100 80G 抢占式约 ¥8-12/h
#
# 系统盘建议 200GB ESSD（模型 + Docker 镜像）
ECS_INSTANCE_ID=i-bp1xxxxxxxxxxxxxxxxx
ECS_PRIVATE_IP=172.xx.xx.xx

# ── 模型任务 ────────────────────────────────────────────────
# ti2v-5B：TI2V-5B，文本/图片→视频，单卡 24GB，约 10GB 权重
# t2v-A14B：T2V-A14B MoE，纯文本→视频，需要 A100 80G，约 30GB 权重
# i2v-A14B：I2V-A14B MoE，图片→视频，需要 A100 80G，约 30GB 权重
MODEL_TASK=ti2v-5B

# ── OSS 对象存储 ────────────────────────────────────────────
OSS_BUCKET=your-video-bucket
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_URL_EXPIRE=7200

# ── 函数计算 FC ─────────────────────────────────────────────
FC_SERVICE_NAME=wan22-service
FC_FUNCTION_NAME=wan22-trigger
FC_TIMEOUT=600

# ── VPC 网络 ────────────────────────────────────────────────
VPC_ID=vpc-bp1xxxxxxxxxxxxxxxxx
VSWITCH_ID=vsw-bp1xxxxxxxxxxxxxxxxx
SECURITY_GROUP_ID=sg-bp1xxxxxxxxxxxxxxxxx

# ── 行为配置 ────────────────────────────────────────────────
AUTO_STOP=true
# ti2v-5B 首次下载约 10GB（hf-mirror 约 15-20 分钟），设 1800s
# A14B 首次下载约 30GB（约 45-60 分钟），改为 3600
TIMEOUT_START=1800
TIMEOUT_INFER=600
