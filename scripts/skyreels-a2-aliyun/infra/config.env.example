# ── 阿里云账号 ──────────────────────────────────────────────
ALIBABA_ACCESS_KEY=your_access_key_id
ALIBABA_ACCESS_SECRET=your_access_key_secret
REGION_ID=cn-hangzhou

# ── ACR 容器镜像仓库 ────────────────────────────────────────
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your-namespace
ACR_REPO=skyreels-a2
IMAGE_TAG=latest

# ── ECS GPU 实例 ────────────────────────────────────────────
# SkyReels-A2（14B）在 540P 下峰值 VRAM 约 51GB，需要 A100 80G
# 推荐：ecs.gn7e-c16g1.4xlarge（A100 80G × 1，抢占式约 ¥8-12/h）
# 系统盘建议 200GB ESSD（模型权重约 28GB + Docker 镜像）
ECS_INSTANCE_ID=i-bp1xxxxxxxxxxxxxxxxx
ECS_PRIVATE_IP=172.xx.xx.xx

# ── OSS 对象存储 ────────────────────────────────────────────
OSS_BUCKET=your-video-bucket
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_URL_EXPIRE=7200

# ── 函数计算 FC ─────────────────────────────────────────────
FC_SERVICE_NAME=skyreels-service
FC_FUNCTION_NAME=skyreels-a2-trigger
FC_TIMEOUT=600

# ── VPC 网络 ────────────────────────────────────────────────
VPC_ID=vpc-bp1xxxxxxxxxxxxxxxxx
VSWITCH_ID=vsw-bp1xxxxxxxxxxxxxxxxx
SECURITY_GROUP_ID=sg-bp1xxxxxxxxxxxxxxxxx

# ── 行为配置 ────────────────────────────────────────────────
AUTO_STOP=true
# 首次启动需下载约 28GB 模型（hf-mirror 约 30-60 分钟），设 2400s 兜底
# 后续启动模型已在磁盘，实际约 90-120 秒
TIMEOUT_START=2400
TIMEOUT_INFER=600
