# ══════════════════════════════════════════════════════════════
# SkyReels-A2 阿里云部署配置
# 使用方式：cp config.env.example config.env 并填写真实值
# ══════════════════════════════════════════════════════════════

# ── 阿里云账号 ─────────────────────────────────────────────
ALIBABA_ACCESS_KEY=your_access_key_id
ALIBABA_ACCESS_SECRET=your_access_key_secret
REGION_ID=cn-hangzhou

# ── ACR 容器镜像仓库 ───────────────────────────────────────
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your-namespace
ACR_REPO=skyreels-a2
IMAGE_TAG=latest

# ── ECS GPU 实例 ───────────────────────────────────────────
# 推荐规格：
#   ecs.gn7e-c16g1.4xlarge  → A100 80G × 1  (约 ¥34/h 按量，抢占式约 ¥10/h)
#   ecs.gn7i-c32g1.8xlarge  → A10 24G × 2   (需开启 NVLink，约 ¥25/h)
# SkyReels-A2 (14B) 在 540P 下需要约 51GB VRAM，推荐 A100 80G 单卡
ECS_INSTANCE_ID=i-bp1xxxxxxxxxxxxxxxxx
ECS_PRIVATE_IP=172.xx.xx.xx
# 系统盘建议 100GB ESSD（模型权重约 28GB + Docker 镜像约 20GB）

# ── OSS 对象存储 ───────────────────────────────────────────
OSS_BUCKET=your-video-bucket
# 内网端点（ECS 和 OSS 在同一 Region 时免流量费）
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
# 生成视频的 OSS 链接有效期（秒），默认 7200 = 2 小时
OSS_URL_EXPIRE=7200

# ── 函数计算 FC ────────────────────────────────────────────
FC_SERVICE_NAME=skyreels-service
FC_FUNCTION_NAME=skyreels-a2-trigger
# FC 函数超时（秒）：视频生成耗时约 3-10 分钟，建议设 600
FC_TIMEOUT=600

# ── VPC 网络（FC 须与 ECS 在同一 VPC，才能访问内网 IP）───
VPC_ID=vpc-bp1xxxxxxxxxxxxxxxxx
VSWITCH_ID=vsw-bp1xxxxxxxxxxxxxxxxx
SECURITY_GROUP_ID=sg-bp1xxxxxxxxxxxxxxxxx

# ── 推理参数默认值 ─────────────────────────────────────────
# AUTO_STOP: 推理完成后是否自动关机 ECS（true 省钱，false 保持热启动）
AUTO_STOP=true
TIMEOUT_START=300
TIMEOUT_INFER=600
