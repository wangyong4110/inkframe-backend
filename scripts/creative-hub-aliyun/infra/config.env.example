# ── 阿里云账号 ──────────────────────────────────────────────
ALIBABA_ACCESS_KEY=your_access_key_id
ALIBABA_ACCESS_SECRET=your_access_key_secret
REGION_ID=cn-hangzhou

# ── ACR ────────────────────────────────────────────────────
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your-namespace
ACR_REPO=creative-hub
IMAGE_TAG=latest

# ── ECS GPU 实例（A10 24GB）────────────────────────────────
# 推荐规格：ecs.gn7i-c16g1.4xlarge（A10 24G × 1，抢占式约 ¥3-5/h）
# 系统盘建议 200GB ESSD（模型合计约 20GB）
ECS_INSTANCE_ID=i-bp1xxxxxxxxxxxxxxxxx
ECS_PRIVATE_IP=172.xx.xx.xx

# ── OSS ────────────────────────────────────────────────────
OSS_BUCKET=your-media-bucket
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_URL_EXPIRE=7200

# ── FC ─────────────────────────────────────────────────────
FC_SERVICE_NAME=creative-hub-service
FC_FUNCTION_NAME=creative-hub-trigger
FC_TIMEOUT=600

# ── VPC ────────────────────────────────────────────────────
VPC_ID=vpc-bp1xxxxxxxxxxxxxxxxx
VSWITCH_ID=vsw-bp1xxxxxxxxxxxxxxxxx
SECURITY_GROUP_ID=sg-bp1xxxxxxxxxxxxxxxxx

# ── 行为配置 ────────────────────────────────────────────────
AUTO_STOP=true
# 首次启动：Wan2.2(10GB) + TangoFlux(2GB) + ACE-Step(8GB) ≈ 20GB
# hf-mirror 下载约 20-40 分钟，设 3600s 兜底
TIMEOUT_START=3600
TIMEOUT_INFER=600
