# ── 阿里云账号 ──────────────────────────────────────────────
ALIBABA_ACCESS_KEY=your_access_key_id
ALIBABA_ACCESS_SECRET=your_access_key_secret
REGION_ID=cn-hangzhou

# ── ACR 容器镜像仓库 ────────────────────────────────────────
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your-namespace
ACR_REPO=mmaudio
IMAGE_TAG=latest

# ── ECS 实例 ────────────────────────────────────────────────
# MMAudio large_44k_v2 推理约 6GB 显存（16-bit），T4 16GB 完全够用
# 推荐：ecs.gn6i-c4g1.xlarge（4核15G + T4 16G，抢占式约 ¥0.5-0.9/h）
ECS_INSTANCE_ID=i-bp1xxxxxxxxxxxxxxxxx
ECS_PRIVATE_IP=172.xx.xx.xx

# ── OSS 对象存储 ────────────────────────────────────────────
OSS_BUCKET=your-sfx-bucket
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_URL_EXPIRE=3600

# ── 函数计算 FC ─────────────────────────────────────────────
FC_SERVICE_NAME=mmaudio-service
FC_FUNCTION_NAME=mmaudio-trigger

# ── VPC 网络 ────────────────────────────────────────────────
VPC_ID=vpc-bp1xxxxxxxxxxxxxxxxx
VSWITCH_ID=vsw-bp1xxxxxxxxxxxxxxxxx
SECURITY_GROUP_ID=sg-bp1xxxxxxxxxxxxxxxxx

# ── 行为配置 ────────────────────────────────────────────────
# 首次启动含模型下载（约 4GB，10-15 分钟），TIMEOUT_START 设 1200 兜底
# 后续启动模型已在磁盘，实际约 60-90 秒
AUTO_STOP=true
TIMEOUT_START=1200
TIMEOUT_INFER=120
